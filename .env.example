# Circular Campus — variables de entorno documentadas.
# Copia este archivo como .env (no se versiona) o configúralas en Render.
# Nunca escribas credenciales reales en el repositorio.

# --- Base de datos ---------------------------------------------------------
# PostgreSQL gestionado. Obligatorio con APP_ENV=production; es un secreto.
# DATABASE_URL=postgresql://usuario:clave@host:5432/base
# Ruta SQLite alternativa para desarrollo local (ignorada en producción).
# DATABASE=./campus_circular.db

# --- Entorno ---------------------------------------------------------------
APP_ENV=development
PORT=5000
# 0 desactiva los objetos, entregas y perfiles de demostración.
# Con 1 se habilita además la cuenta temporal «Probar al instante» del congreso.
SEED_DEMO=1
# Horas que vive una cuenta temporal de demostración (sus publicaciones se
# conservan en el catálogo al caducar).
# DEMO_TTL_HOURS=24
# Techo global de peticiones a /api/ por IP y minuto. Súbelo en una exposición
# donde todos los asistentes comparten la misma IP: por ejemplo 900.
# API_RATE_LIMIT=300

# --- Identidad y textos legales -------------------------------------------
# Sustituir por un correo real antes de usar datos personales reales.
CONTACT_EMAIL=privacidad@circular-campus.example
CONTROLLER_NAME=Equipo Circular Campus (proyecto académico independiente)
LEGAL_VERSION=2026-11-20
LEGAL_UPDATED=2026-11-20

# --- Confianza -------------------------------------------------------------
# Dominios de correo institucional (separados por comas) para la insignia
# informativa. Si se omite, se usa la lista interna del código.
# UNIVERSITY_DOMAINS=uvigo.gal,udc.es,usc.es

# --- Seguridad y moderación ------------------------------------------------
# Orígenes permitidos para la API (CORS), separados por comas. En local se
# añaden automáticamente localhost:5000 y 127.0.0.1:5000.
# CORS_ORIGINS=https://campus-circular.onrender.com
# 1 activa los límites de peticiones; 0 los desactiva (solo para depurar).
RATE_LIMIT_ENABLED=1
# Saltos de proxy de confianza para leer la IP real en X-Forwarded-For
# (Render: 1). Usa 0 si expones la app sin proxy delante.
TRUST_PROXY=1
# Reportes de cuentas distintas que retiran una publicación hasta su revisión.
REPORT_HIDE_THRESHOLD=3
# 1 permite embeber la app en un iframe de otro origen (solo para el preview del
# entorno de desarrollo). En producción el valor por defecto es 0, que deja
# `frame-ancestors 'self'` y `X-Frame-Options: SAMEORIGIN`.
# ALLOW_EMBED=0
